# Copy this file to .env and fill in real values. Never commit the real .env file.
# Per the Combined QA Lab Learner Guide: your instructor/lab platform assigns a VM IP.
# The lab VM hosts both demo apps on one host, on different ports.

# Replace <your-lab-vm-ip> with your assigned learner VM IP.
LAB_HOST=http://34.93.84.32

# FinServe Retail Demo (this repo's active suite)
FINSERVE_BASE_URL=http://34.93.84.32:8082
API_BASE_URL=http://34.93.84.32:8082/api
API_KEY=qa-demo-token-123

# Insurance Order Entry Demo (placeholder for tests/insurance-order-entry/)
INSURANCE_BASE_URL=http://34.93.84.32:8081
INSURANCE_API_KEY=qa-insurance-demo-token-123

# Standard QA demo user (FinServe)
QA_USER_EMAIL=qauser@finserve.test
QA_USER_PASSWORD=Password@123

# Additional seeded FinServe users used across test suites
INVESTOR_USER_EMAIL=investor1@finserve.test
INVESTOR_USER_PASSWORD=Password@123

NEW_USER_EMAIL=newuser@finserve.test
NEW_USER_PASSWORD=Password@123

INSURANCE_USER_EMAIL=insurance1@finserve.test
INSURANCE_USER_PASSWORD=Password@123

LOCKED_USER_EMAIL=locked@finserve.test
LOCKED_USER_PASSWORD=Password@123

# CI toggle: set to "true" to run in headless CI mode with retries
CI=false
